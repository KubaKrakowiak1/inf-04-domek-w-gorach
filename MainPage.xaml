<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mobilna.MainPage"
             >
    <Shell.TitleView>
        <Label Text="Domek W GÓRACH"
               FontFamily="OpenSansSemibold" 
               FontSize="20"
               FontAttributes="Bold"
               TextColor="Gray"
               HorizontalOptions="Start"
               VerticalOptions="Center" />
    </Shell.TitleView>

    <Grid>
        <VerticalStackLayout Margin="0, 20, 0, 0">
        <StackLayout>

                <HorizontalStackLayout BackgroundColor="#008080">
                    
            <Button x:Name="polub" Text="Polub" Clicked="Polub" BackgroundColor="#008080" TextColor="#FFFFFF"></Button>
            <Button x:Name="usun" Text="Usuń" Clicked="Usun" BackgroundColor="#008080" TextColor="#FFFFFF"></Button>
            <Button x:Name="Zapisz" Text="Zapisz" BackgroundColor="#008080" TextColor="#FFFFFF"></Button>
                </HorizontalStackLayout>
            <Label x:Name="polubienia" Text="0 Polubień" HorizontalTextAlignment="End"></Label>
            <Line X2="200" Aspect="Fill" HorizontalOptions="Fill" Stroke="Gray" StrokeThickness="2" />
            <Label  Text="Opis" FontAttributes="Bold"></Label>
        </StackLayout>
            <Label Text="Odwiedź komfortowy domek w Sudetach, blisko do szlaków turystycznych" TextColor="#808080"></Label>
        </VerticalStackLayout>
    </Grid>

</ContentPage>
